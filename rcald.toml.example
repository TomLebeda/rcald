# rcald configuration
#
# fetch_period: how often calendars are re-downloaded.
# In --once mode this is also the emission horizon (now + fetch_period).
# Humantime format: "30m", "45m", "1h", "1h30m".
fetch_period = "30m"

# One [[calendars]] block per calendar.
#
# name:   arbitrary label, used in the output JSON ("calendar" field).
# url:    https URL of an ICS feed (e.g. Google Calendar secret address),
#         or a plain local file path.
# fallback_offsets: recommended only as a safety net! Reminder times before
#         event start, applied ONLY to events that have no VALARMs in the feed.
#         VALARMs always win. Humantime format ("15m", "1h", "24h", "7d").
# fallback_all_day_offsets: same, but for all-day (VALUE=DATE) events.
#
# Note: Google Calendar only exports VALARMs for reminders set explicitly
# per event. Calendar-level default notifications are never exported,
# so events relying on those need fallback_offsets to get any reminder.

[[calendars]]
name = "personal"
url = "https://calendar.google.com/calendar/ical/USER%40gmail.com/private-XXXXXXXXX/basic.ics"
fallback_offsets = ["20m", "1h", "3h", "24h", "168h"]
fallback_all_day_offsets = ["24h", "48h", "92h"]

[[calendars]]
name = "work"
url = "https://calendar.google.com/calendar/ical/HASH%40group.calendar.google.com/private-XXXXXXXXX/basic.ics"
fallback_offsets = ["30m"]
fallback_all_day_offsets = ["24h"]

# local feed for testing:
# [[calendars]]
# name = "test"
# url = "/path/to/feed.ics"
